---
import TourDetail from '../../components/TourDetail.astro';
import { toursByLocale, type Tour } from '../../data/tours';

export function getStaticPaths() {
  return toursByLocale.en.map((tour) => ({ params: { slug: tour.slug }, props: { tour } }));
}

interface Props { tour: Tour; }
const { tour } = Astro.props;
---
<TourDetail locale="en" tour={tour} />
